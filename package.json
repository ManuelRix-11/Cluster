{
  "name": "IUE - TestsUnisaExams",
  "version": "1.0.0",
  "description": "App desktop per i test simulare degli esami di informatica Unisa",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "com.quizapp.desktop",
    "productName": "Quiz App",
    "files": [
      "main.js",
      "preload.js",
      "quiz-web/**",
      "Quizzes/**",
      "images/**"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Education"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
