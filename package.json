{
  "name": "Cluster",
  "version": "1.0.1",
  "description": "Hub di studio e simulatore d'esami per Informatica Unisa",
  "author": "Emanuele Ragozzini",
  "license": "PolyForm-Strict-1.0.0",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"vite --force\" \"wait-on http://localhost:5173 && electron .\"",
    "dev:clean": "node -e \"fs.rmSync('node_modules/.vite', { recursive: true, force: true })\" && concurrently \"vite --force\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder --win --x64",
    "build:linux": "vite build && electron-builder --linux",
    "build:mac": "vite build && electron-builder --mac",
    "release": "vite build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.11",
    "marked": "^18.0.9",
    "mermaid": "^11.4.1",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "vite": "^8.2.0",
    "wait-on": "^8.0.5"
  },
  "build": {
    "appId": "com.cluster.desktop",
    "productName": "Cluster — Informatica UNISA",
    "icon": "assets/logoIUE.png",
    "publish": [
      {
        "provider": "github",
        "owner": "ManuelRix-11",
        "repo": "Cluster"
      }
    ],
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/dist/**",
      "Quizzes/**",
      "images/**",
      "assets/**",
      "Notes/**",
      "Materiale_Esercizi/**"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Education"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.education"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}