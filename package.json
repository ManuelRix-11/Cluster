{
  "name": "Cluster",
  "version": "1.0.0",
  "description": "Hub di studio e simulatore d'esami per Informatica Unisa",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && electron-builder --win --x64",
    "build:linux": "vite build && electron-builder --linux"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "marked": "^18.0.9",
    "monaco-editor": "^0.56.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.4",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "wait-on": "^8.0.5",
    "vite": "^8.2.0"
  },
  "build": {
    "appId": "com.cluster.desktop",
    "productName": "Cluster — Informatica UNISA",
    "icon": "assets/logoIUE.png",
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer/dist/**",
      "Quizzes/**",
      "images/**",
      "assets/**"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "tar.gz"
      ],
      "category": "Education"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
